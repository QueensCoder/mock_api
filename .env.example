# App
APP_ENV=development
SECRET_KEY=change-me-in-production
DEBUG=true

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/app

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=app-bucket
S3_REGION=us-east-1

# Clerk (https://dashboard.clerk.com → API Keys)
# JWKS URL: Clerk Dashboard → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
# Issuer: your Clerk Frontend API URL (leave empty to skip issuer check locally)
CLERK_ISSUER=https://<your-clerk-frontend-api>
