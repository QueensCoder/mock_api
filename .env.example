# App
APP_ENV=development
SECRET_KEY=change-me-in-production
DEBUG=true

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/app

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=app-bucket
S3_REGION=us-east-1

# Stytch (https://stytch.com/dashboard/api-keys)
# Use project-test-* / secret-test-* for local dev, project-live-* for production
STYTCH_PROJECT_ID=project-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
STYTCH_SECRET=secret-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Airflow ETL ───────────────────────────────────────────────────────────────
# Generate fernet key: make etl-keygen
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme-in-prod
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# DuckDB (local Snowflake substitute)
DUCKDB_PATH=/opt/airflow/duckdb/analytics.duckdb

# Production Snowflake (leave blank for local dev)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=ANALYTICS
